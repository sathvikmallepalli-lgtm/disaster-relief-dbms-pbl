# Copy these values into your shell environment before running the app.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=disaster_relief
DB_USER=relief_app
DB_PASSWORD=change-me
# For a local Unix-socket server, set DB_SOCKET instead of DB_HOST/DB_PORT.
# DB_SOCKET=/path/to/mysql.sock
FLASK_SECRET_KEY=replace-with-a-random-local-value
